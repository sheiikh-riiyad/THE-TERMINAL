{
  "name": "the-terminal",
  "version": "2.1.4",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "start:sim": "SIMULATE_SCALE=1 electron --ozone-platform=x11 .",
    "mobile:start": "npm --prefix mobile-live-weight run start",
    "mobile:android": "npm --prefix mobile-live-weight run android",
    "mobile:web": "npm --prefix mobile-live-weight run web",
    "license:keypair": "node scripts/generate-license-keypair.js"
  },
  "keywords": [],
  "author": {
    "name": "https://ninjaaetheriondev.netlify.app",
    "email": "riiyad.san1819@gmail.com"
  },
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^42.4.0",
    "electron-builder": "^26.0.0",
    "node-abi": "^4.31.0",
    "nodemon": "^3.1.11"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.6.2",
    "electron-updater": "^6.7.3",
    "firebase": "^12.14.0",
    "qrcode": "^1.5.4",
    "serialport": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "Ninja Aetherion Dev",
    "productName": "The Terminal",
    "icon": "terminal2.ico",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "executableName": "the-terminal",
      "desktop": {
        "entry": {
          "Name": "The Terminal"
        }
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sheiikh-riiyad",
        "repo": "THE-TERMINAL"
      }
    ]
  }
}
